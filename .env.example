# Variables para Docker Compose. Copia este archivo como .env y cambia los valores.

# Contraseña de la base de datos del contenedor (solo letras y números)
DB_PASSWORD=cambia_esta_contrasena

# Clave para firmar los tokens: mínimo 32 caracteres aleatorios
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria