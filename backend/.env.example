PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=libros_interactivos
DB_USER=postgres
DB_PASSWORD=tu_contraseña_de_postgres
# Dirección del frontend que puede llamar a la API (si son varias, sepáralas con coma)
CORS_ORIGIN=http://localhost:5173
# Mínimo 32 caracteres aleatorios. Con este valor de ejemplo el servidor no arranca.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=2h
# Clave de la YouTube Data API v3 (Google Cloud). Opcional: sin ella, los videos no se verifican
YOUTUBE_API_KEY=